# Kopieer dit bestand naar .env.local en vul je eigen waarden in
# cp .env.local.example .env.local

# Supabase — haal deze op uit je Supabase dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://jouw-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=jouw-anon-key-hier

# Sentry — maak gratis account op sentry.io, project type: Next.js
# DSN staat onder Settings > Projects > strq-web > Client Keys
NEXT_PUBLIC_SENTRY_DSN=

# Stripe — activeer wanneer Twin premium feature live gaat
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PREMIUM_PRICE_ID=
# SUPABASE_SERVICE_ROLE_KEY=
